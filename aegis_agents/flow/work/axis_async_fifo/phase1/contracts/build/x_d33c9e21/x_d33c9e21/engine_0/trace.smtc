initial
assume (= [aegis_init] true)
assume (= [chk.f_ok] #x00)
assume (= [chk.past_ptr] #b000000)
assume (= [dut.$auto$async2sync.cc:253:execute$554] true)
assume (= [dut.$auto$async2sync.cc:253:execute$556] true)
assume (= [dut.drop_frame_reg] false)
assume (= [dut.m_axis_pipe_reg[0]] #b0000000000)
