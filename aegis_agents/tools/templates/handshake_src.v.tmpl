// AEGIS CDC contract: handshake_src  (crossing @ID@)
// Source-domain guarantees for a 4-phase (return-to-zero) req/ack handshake
// carrying a data bus. ack_sync is the source domain's synchronized copy of
// ack and is left completely unconstrained: these properties must hold for
// ANY behaviour of the far domain.
// Generated by gen_cdc_props.py -- do not edit by hand.
//
//  [H1] data is stable on every cycle that follows a cycle with req high.
//  [H2] once raised, req is held until ack_sync is observed.
//  [H3] a new req is not raised while ack_sync is still high (the far side
//       must see req drop before the next transfer, or the edge is lost).
module @MOD@ #(parameter W = @W@) (
  input wire         clk,
  input wire         rst_act,
  input wire         req,
  input wire         ack_sync,
  input wire [W-1:0] data
);
@COMMON@
  reg         past_req, past_ack;
  reg [W-1:0] past_data;
  always @(posedge clk) begin
    past_req  <= req;
    past_ack  <= ack_sync;
    past_data <= data;
  end

  wire f_chk = (f_ok >= 8'd1) && !rst_act;

  always @(*) if (f_chk && past_req)              assert (data == past_data); // [H1]
  always @(*) if (f_chk && past_req && !past_ack) assert (req);               // [H2]
  always @(*) if (f_chk && !past_req && past_ack) assert (!req);              // [H3]
endmodule
