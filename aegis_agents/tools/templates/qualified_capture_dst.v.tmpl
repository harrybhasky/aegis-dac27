// AEGIS CDC contract: qualified_capture_dst  (crossing @ID@)
// Destination-domain guarantee for any crossing whose data bus is NOT
// synchronized bit-by-bit (handshake, qualifier bus): the capture register
// may only load shortly after a synchronized qualifier event. The data bus
// itself is an unconstrained input, so an unqualified capture is caught
// regardless of what the far domain does.
// Event kind: @EV_KIND@ ("rise" for req/ack handshakes, "any" for toggles).
// Generated by gen_cdc_props.py -- do not edit by hand.
//
//  [A1] environment: the synchronized qualifier holds 0 while this domain
//       is in reset (it comes from this domain's own reset synchronizer chain).
//  [D1] the capture register changes only within LAT cycles of an event.
module @MOD@ #(parameter W = @W@, parameter LAT = @LAT@) (
  input wire         clk,
  input wire         rst_act,
  input wire         ev_sig,
  input wire [W-1:0] data_dst
);
@COMMON@
  reg           past_ev;
  reg [W-1:0]   past_dout;
  reg [LAT-1:0] ev_hist = {LAT{1'b0}};
  wire          ev = @EV_EXPR@;

  always @(posedge clk) begin
    past_ev   <= ev_sig;
    past_dout <= data_dst;
    ev_hist   <= {ev_hist, ev};
  end

  wire f_chk = (f_ok >= 8'd1) && !rst_act;

  always @(*) if (rst_act) assume (ev_sig == 1'b0);                     // [A1]
  always @(*) if (f_chk && (data_dst != past_dout)) assert (|ev_hist); // [D1]
endmodule
