// AEGIS CDC contract: qualbus_src  (crossing @ID@)
// Source-domain guarantees for an open-loop multi-bit bus with a qualifier
// (data held stable, qualifier toggled and synchronized, far side captures
// on the synchronized qualifier edge). There is no ack, so safety rests on
// a hold window N_HOLD computed from the SDC periods:
//     N_HOLD = ceil((sync_stages + 2) * T_dst / T_src)   [source cycles]
// Generated by gen_cdc_props.py -- do not edit by hand.
//
//  [Q1] data changes only on a qualifier event, or once N_HOLD source
//       cycles have passed since the last event.
//  [Q2] qualifier events are at least N_HOLD source cycles apart.
module @MOD@ #(parameter W = @W@, parameter N_HOLD = @N_HOLD@) (
  input wire         clk,
  input wire         rst_act,
  input wire         qual,
  input wire [W-1:0] data
);
@COMMON@
  reg         past_qual;
  reg [W-1:0] past_data;
  reg [7:0]   since = 8'hff;
  wire        q_chg = (qual != past_qual);

  always @(posedge clk) begin
    past_qual <= qual;
    past_data <= data;
    if (rst_act)              since <= 8'hff;
    else if (q_chg)           since <= 8'd1;
    else if (since != 8'hff)  since <= since + 8'd1;
  end

  wire f_chk = (f_ok >= 8'd1) && !rst_act;

  always @(*) if (f_chk && (data != past_data)) assert (q_chg || (since >= N_HOLD)); // [Q1]
  always @(*) if (f_chk && q_chg)               assert (since >= N_HOLD);           // [Q2]
endmodule
