// AEGIS CDC contract: pulse_src  (crossing @ID@)
// Source-domain guarantees for a toggle-based pulse synchronizer: each input
// pulse must become exactly one level change on the crossing signal, so the
// far side can recover it by edge detection whatever its clock ratio.
// Generated by gen_cdc_props.py -- do not edit by hand.
//
//  [P1] the crossing signal changes iff a pulse arrived LAT cycles earlier
//       (no lost pulses, no spurious changes, never sent as a raw pulse).
//  [P2] input pulses are at least MIN_GAP source cycles apart. MIN_GAP is
//       derived from the SDC clock periods. Emitted as @RATE_KIND@:
//       "assume" = obligation on whoever drives pulse_in (reported upward),
//       "assert" = this module generates the pulses and must self-limit.
module @MOD@ #(parameter LAT = @LAT@, parameter MIN_GAP = @MIN_GAP@) (
  input wire clk,
  input wire rst_act,
  input wire pulse_in,
  input wire tgl
);
@COMMON@
  reg           past_tgl;
  reg [LAT-1:0] p_hist = {LAT{1'b0}};
  always @(posedge clk) begin
    past_tgl <= tgl;
    p_hist   <= {p_hist, pulse_in};
  end

  reg [7:0] f_gap = 8'hff;
  always @(posedge clk)
    if (rst_act)              f_gap <= 8'hff;
    else if (pulse_in)        f_gap <= 8'd1;
    else if (f_gap != 8'hff)  f_gap <= f_gap + 8'd1;

  wire f_chk = (f_ok >= LAT) && !rst_act;

  always @(*) if (f_chk) assert ((tgl != past_tgl) == p_hist[LAT-1]);   // [P1]
  always @(*) if (!rst_act && pulse_in) @RATE_KIND@ (f_gap >= MIN_GAP); // [P2]
endmodule
